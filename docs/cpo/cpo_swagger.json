{
    "swagger": "2.0",
    "info": {
        "description": "Fake charging station data for the OCPI learning project.",
        "title": "Mock CPO API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8081",
    "basePath": "/",
    "paths": {
        "/api/locations": {
            "get": {
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/main.Location"
                            }
                        }
                    }
                }
            }
        },
        "/api/locations/{id}": {
            "get": {
                "description": "Returns one location by its ID",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "locations"
                ],
                "summary": "Get one location",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Location ID, for example LOC01",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/main.Location"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/main.errorReply"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "main.Connector": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "max_kw": {
                    "type": "number"
                },
                "power_type": {
                    "type": "string"
                },
                "standard": {
                    "type": "string"
                }
            }
        },
        "main.EVSE": {
            "type": "object",
            "properties": {
                "connectors": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/main.Connector"
                    }
                },
                "status": {
                    "type": "string"
                },
                "uid": {
                    "type": "string"
                }
            }
        },
        "main.Location": {
            "type": "object",
            "properties": {
                "address": {
                    "type": "string"
                },
                "city": {
                    "type": "string"
                },
                "country": {
                    "type": "string"
                },
                "evses": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/main.EVSE"
                    }
                },
                "id": {
                    "type": "string"
                },
                "last_updated": {
                    "type": "string"
                },
                "latitude": {
                    "type": "number"
                },
                "longitude": {
                    "type": "number"
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "main.errorReply": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                }
            }
        }
    }
}